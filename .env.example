# Copy to .env and fill in. .env is git-ignored — never commit real secrets.

# --- web ---
SECRET_KEY=change-me-to-a-long-random-string
HOST=0.0.0.0
PORT=8080

# --- who the invoices are from ---
TECH_NAME=Matthew Cooper
TECH_ADDRESS_1=400 S 250 W
TECH_ADDRESS_2=Lagrange IN 46761
TECH_PHONE=(574) 310-7482
TECH_EMAIL=you@example.com

# --- who the invoices go to ---
BILL_TO_NAME=Ritchie Installation and Communications
BILL_TO_ADDRESS_1=2802 Congressional Parkway Suite B
BILL_TO_ADDRESS_2=Fort Wayne IN 46808
BILL_TO_EMAIL=contractor@example.com

# --- email (Gmail needs a 16-character App Password, not your login) ---
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SENDER_EMAIL=you@example.com
EMAIL_PASSWORD=your-app-password
YOUR_EMAIL=you@example.com
CONTRACTOR_EMAIL=contractor@example.com

# --- optional AI label reading; leave blank to use on-device OCR only ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- storage ---
MERCURY_DATA_DIR=./data

# --- sandbox ---
# Set to 1 to run the demo: separate database, fictional identity, sample data,
# and email written to data/demo/outbox instead of sent. `python demo.py` sets
# this for you, so you normally do not need it here.
# MERCURY_DEMO=0
